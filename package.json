    "@ngrx/signals": "^20.1.0",
    "openai": "^6.10.0",
    "prettier": "^3.7.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@angular/build": "^21.0.2",
