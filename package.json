    "@angular/router": "^20.1.4",
    "@ngrx/signals": "^20.0.0",
    "openai": "^5.11.0",
    "prettier": "^3.6.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@angular/build": "^20.1.4",
